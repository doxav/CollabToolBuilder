{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    },
    {
      "name": "🧠 Run optimization",
      "type": "python",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "optimisation.${fileBasenameNoExtension}",
      "justMyCode": false
    },
    { // Test (provide a nice Test icon different from Run)
      "name": "🚦 Run test",
      "type": "python",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "tests.${fileBasenameNoExtension}",
      "justMyCode": false
    }
  ]
}