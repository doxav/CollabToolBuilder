+    config.discourse_manage_lm = dummy_lm
+    config.utterance_polishing_lm = dummy_lm
+    config.warmstart_outline_gen_lm = dummy_lm
+    config.question_asking_lm = dummy_lm
+    config.knowledge_base_lm = dummy_lm
+    
+    return config
+
+@pytest.fixture
+def logging_wrapper(lm_config):
+    """Fixture for logging wrapper."""
+    return LoggingWrapper(lm_config)
+
+@pytest.fixture
+def runner_args():
