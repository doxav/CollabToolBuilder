+"""1A.Feature10: HumanLLM Support testing."""
+import pytest, os
+import sys
+sys.path[0] = os.path.abspath(os.path.join(os.getcwd()))
+sys.path.insert(0, os.path.abspath(os.path.join(os.getcwd(), '../../../')))
+from unittest import mock
+from typing import List, Dict, Any, Optional
+
+try:
+    from knowledge_storm.human_llm_adapter import HumanLLMAdapter
+    from knowledge_storm.collaborative_storm.modules.co_storm_agents import CoStormExpert, Moderator
+    from knowledge_storm.collaborative_storm.engine import CoStormRunner, RunnerArgument, CollaborativeStormLMConfigs
+    from knowledge_storm.dataclass import KnowledgeBase, ConversationTurn
+    from knowledge_storm.logging_wrapper import LoggingWrapper
+    from utils.human_llm import HumanLLM
+    from knowledge_storm.rm import (
+        SearXNG
+    )
+except ImportError:
+    raise ImportError("Ensure the modules are correctly imported.")
+
+# ----- TEST DOUBLES -----
+LLM_LIST = []
+
+
+class DummyLM:
+    """Test double for language model."""
+    def __init__(self, model_name="dummy-model"):
+        self.model = model_name
+        self.kwargs = {"model": model_name}
+        self.history = []
+        
+    def __call__(self, prompt, **kwargs):
+        self.history.append(prompt)
+        # Simple response based on the input
+        return f"Response to: {prompt[:20]}..."
+    
+    def generate(self, prompt, **kwargs):
+        return self(prompt, **kwargs)
+
+class MockHumanLLM:
+    """Mock implementation of HumanLLM for testing."""
+    def __init__(self, agent_name, llmORchains_list=None, **kwargs):
+        self.agent_name = agent_name
+        self.llmORchains_list = llmORchains_list or []
+        self.call_history = []
+    
+    def invoke(self, user_message, return_message_content_only=False, **kwargs):
+        self.call_history.append({
+            "message": user_message,
+            "return_content_only": return_message_content_only,
+            "kwargs": kwargs
+        })
+        # Return a response that includes the agent name for testing
+        response = f"Human response from {self.agent_name}: {user_message[:20]}..."
+        return [response] if return_message_content_only else response
+
+# ----- FIXTURES -----
+
+@pytest.fixture
+def mock_human_llm():
+    """Create a mock for the HumanLLM class."""
+    with mock.patch("utils.human_llm", MockHumanLLM):
+        yield
+
+# @pytest.fixture
